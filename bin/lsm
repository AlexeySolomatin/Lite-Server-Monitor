#!/usr/bin/env bash
# ==============================================================================
# Lite Server Monitor (LSM)
# Главный исполняемый CLI
#
# Путь:
#   bin/lsm
#
# Назначение:
#   Главная точка входа в командный интерфейс LSM.
#
# Поддерживаемые команды:
#
#   lsm help
#   lsm version
#   lsm modules
#   lsm install
#   lsm uninstall
#   lsm update
#   lsm status
#   lsm doctor
#   lsm report
#   lsm config
#   lsm tui
#
# Для команд, требующих административных прав, автоматически
# выполняется перезапуск через sudo.
# ==============================================================================

set -Eeuo pipefail


#
# Минимальный аварийный вывод.
#
# Используется до загрузки библиотек LSM, когда функции
# стандартного логирования еще недоступны.
#

bootstrap_error()
{
    printf "ОШИБКА: %s\n" "$*" >&2
}


#
# Определение корня проекта.
#
# Приоритет:
#
#   1. Уже установленная переменная LSM_ROOT.
#   2. Стандартный путь установки /opt/lsm.
#   3. Каталог проекта относительно текущего файла.
#

if [[ -n "${LSM_ROOT:-}" ]]; then

    :

elif [[ -d "/opt/lsm" ]]; then

    LSM_ROOT="/opt/lsm"

else

    LSM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fi


readonly LSM_ROOT

export LSM_ROOT


#
# Проверка структуры проекта.
#

if [[ ! -d "${LSM_ROOT}/commands" ]]; then

    bootstrap_error "Каталог commands не найден."

    printf "LSM_ROOT=%s\n" "${LSM_ROOT}" >&2

    exit 1

fi


#
# Загрузка базового окружения и системы логирования.
#

if [[ -f "${LSM_ROOT}/lib/core/common.sh" ]]; then

    # shellcheck source=/dev/null
    source "${LSM_ROOT}/lib/core/common.sh"

fi


if [[ -f "${LSM_ROOT}/lib/core/logging.sh" ]]; then

    # shellcheck source=/dev/null
    source "${LSM_ROOT}/lib/core/logging.sh"

fi


#
# Автоматическое получение прав root.
#
# Если текущий пользователь не root и команда требует
# административных прав, выполняется повторный запуск
# этой же команды через sudo.
#

ensure_root()
{
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then

        if command -v sudo >/dev/null 2>&1; then

            printf \
                "\033[1;33m[i] [LSM]\033[0m Для выполнения команды '%s' требуются права root. Перезапуск через sudo...\n" \
                "${COMMAND}"

            exec sudo -- "$0" "${COMMAND}" "$@"

        else

            if declare -f log_error >/dev/null 2>&1; then

                log_error "CLI" \
                    "Команда '${COMMAND}' требует прав root, но утилита sudo не найдена."

            else

                bootstrap_error \
                    "Команда '${COMMAND}' требует прав root, но утилита sudo не найдена."

            fi

            exit 1

        fi

    fi
}


#
# Определение команды.
#
# Если команда не указана, используется help.
#

COMMAND="${1:-help}"

shift || true


#
# Обработка команд CLI.
#

case "${COMMAND}" in


    #
    # Справка
    #

    help|-h|--help)

        exec bash "${LSM_ROOT}/commands/help.sh" "$@"

        ;;


    #
    # Версия LSM
    #

    version|-v|--version)

        exec bash "${LSM_ROOT}/commands/version.sh" "$@"

        ;;


    #
    # Список установленных модулей
    #

    modules)

        ensure_root

        exec bash "${LSM_ROOT}/commands/modules.sh" "$@"

        ;;


    #
    # Установка
    #

    install)

        ensure_root

        exec bash "${LSM_ROOT}/commands/install.sh" "$@"

        ;;


    #
    # Удаление
    #

    uninstall)

        ensure_root

        exec bash "${LSM_ROOT}/commands/uninstall.sh" "$@"

        ;;


    #
    # Обновление
    #

    update)

        ensure_root

        exec bash "${LSM_ROOT}/commands/update.sh" "$@"

        ;;


    #
    # Текущее состояние системы
    #

    status)

        ensure_root

        exec bash "${LSM_ROOT}/commands/status.sh" "$@"

        ;;


    #
    # Диагностика
    #

    doctor)

        ensure_root

        exec bash "${LSM_ROOT}/commands/doctor.sh" "$@"

        ;;


    #
    # Отчет
    #

    report)

        ensure_root

        exec bash "${LSM_ROOT}/commands/report.sh" "$@"

        ;;


    #
    # Конфигурация
    #

    config)

        ensure_root

        exec bash "${LSM_ROOT}/commands/config.sh" "$@"

        ;;


    #
    # Текстовый интерфейс
    #

    tui)

        ensure_root

        exec bash "${LSM_ROOT}/lib/tui/tui.sh" "$@"

        ;;


    #
    # Неизвестная команда
    #

    *)

        if declare -f log_error >/dev/null 2>&1; then

            log_error "CLI" \
                "Неизвестная команда: ${COMMAND}"

        else

            bootstrap_error \
                "Неизвестная команда: ${COMMAND}"

        fi


        exec bash "${LSM_ROOT}/commands/help.sh"

        ;;

esac
