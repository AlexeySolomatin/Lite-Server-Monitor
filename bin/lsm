#!/usr/bin/env bash
# ==============================================================================
# Lite Server Monitor (LSM)
# Главный исполняемый CLI
# Путь: bin/lsm
# ==============================================================================

set -Eeuo pipefail


#
# Минимальный аварийный вывод до загрузки LSM
#

bootstrap_error()
{
    printf "ERROR: %s\n" "$*" >&2
}



#
# Определение корня проекта
#

if [[ -n "${LSM_ROOT:-}" ]]; then

    :

elif [[ -d "/opt/lsm" ]]; then

    LSM_ROOT="/opt/lsm"

else

    LSM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fi


readonly LSM_ROOT
export LSM_ROOT



#
# Проверка структуры проекта
#

if [[ ! -d "${LSM_ROOT}/commands" ]]; then

    bootstrap_error "Каталог commands не найден."

    printf "LSM_ROOT=%s\n" "${LSM_ROOT}" >&2

    exit 1

fi



#
# Загрузка базового окружения и логирования
#

if [[ -f "${LSM_ROOT}/lib/core/common.sh" ]]; then
    # shellcheck source=/dev/null
    source "${LSM_ROOT}/lib/core/common.sh"
fi


if [[ -f "${LSM_ROOT}/lib/core/logging.sh" ]]; then
    # shellcheck source=/dev/null
    source "${LSM_ROOT}/lib/core/logging.sh"
fi



#
# Автоматическая эскалация прав до root при необходимости
#

ensure_root()
{
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        if command -v sudo >/dev/null 2>&1; then
            printf "\033[1;33m[i] [LSM]\033[0m Для выполнения команды '%s' требуются права root. Перезапуск через sudo...\n" "${COMMAND}"
            exec sudo -- "$0" "${COMMAND}" "$@"
        else
            if declare -f log_error >/dev/null 2>&1; then
                log_error "CLI" "Команда '${COMMAND}' требует прав root, но утилита sudo не найдена."
            else
                bootstrap_error "Команда '${COMMAND}' требует прав root, но утилита sudo не найдена."
            fi
            exit 1
        fi
    fi
}



COMMAND="${1:-help}"
shift || true



case "${COMMAND}" in

    help|-h|--help)

        exec bash "${LSM_ROOT}/commands/help.sh" "$@"

        ;;


    version|-v|--version)

        exec bash "${LSM_ROOT}/commands/version.sh" "$@"

        ;;


    modules)

        ensure_root

        exec bash "${LSM_ROOT}/commands/modules.sh" "$@"

        ;;


    install)

        ensure_root

        exec bash "${LSM_ROOT}/commands/install.sh" "$@"

        ;;


    uninstall)

        ensure_root

        exec bash "${LSM_ROOT}/commands/uninstall.sh" "$@"

        ;;


    update)

        ensure_root

        exec bash "${LSM_ROOT}/commands/update.sh" "$@"

        ;;


    status)

        ensure_root

        exec bash "${LSM_ROOT}/commands/status.sh" "$@"

        ;;


    doctor)

        ensure_root

        exec bash "${LSM_ROOT}/commands/doctor.sh" "$@"

        ;;


    report)

        ensure_root

        exec bash "${LSM_ROOT}/commands/report.sh" "$@"

        ;;


    config)

        ensure_root

        exec bash "${LSM_ROOT}/commands/config.sh" "$@"

        ;;


    tui)

        ensure_root

        exec bash "${LSM_ROOT}/lib/tui/tui.sh" "$@"

        ;;


    *)

        if declare -f log_error >/dev/null 2>&1; then

            log_error "CLI" "Неизвестная команда: ${COMMAND}"

        else

            bootstrap_error "Неизвестная команда: ${COMMAND}"

        fi


        exec bash "${LSM_ROOT}/commands/help.sh"

        ;;

esac
