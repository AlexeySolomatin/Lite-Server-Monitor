#
# -----------------------------------------------------------------------------
# Lite Server Monitor (LSM)
# Таймер проверки Fail2Ban (каждые 5 минут)
# -----------------------------------------------------------------------------
#

[Unit]
Description=Таймер проверки Fail2Ban (каждые 5 минут)
Documentation=https://github.com/AlexeySolomatin/Lite-Server-Monitor

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=20s
AccuracySec=30s
Persistent=true
Unit=lsm-fail2ban.service

[Install]
WantedBy=timers.target
